# ===========================================
# RANKFORGE ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ===========================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (for payments)
# Get keys from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx

# GitHub OAuth (for repo creation)
# Create an OAuth App at: https://github.com/settings/developers
# Set callback URL to: https://your-domain.com/auth/github/callback
VITE_GITHUB_CLIENT_ID=your-github-client-id

# Google OAuth (for Analytics & Search Console)
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# Set callback URL to: https://your-domain.com/auth/google/callback
# Enable these APIs: Google Analytics Data API, Search Console API
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# ===========================================
# SUPABASE EDGE FUNCTION SECRETS
# Set these in Supabase Dashboard > Project Settings > Edge Functions > Secrets
# ===========================================
# STRIPE_SECRET=sk_live_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx (from Stripe webhook settings)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# SUPABASE_URL=your-project-url
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
