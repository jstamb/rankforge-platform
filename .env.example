# ===========================================
# RANKFORGE ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ===========================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini AI (for content generation)
VITE_GEMINI_API_KEY=your-gemini-api-key

# GitHub OAuth (for repo creation)
VITE_GITHUB_CLIENT_ID=your-github-client-id
# Note: Client Secret should only be used server-side, not in Vite

# Cloudflare (for DNS management)
VITE_CLOUDFLARE_API_TOKEN=your-cloudflare-token

# Google Cloud (for Cloud Run deployment)
# Store the service account JSON file path (not the contents)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
VITE_GOOGLE_CLOUD_PROJECT_ID=your-project-id
VITE_GOOGLE_CLOUD_REGION=us-central1

# N8N Automation (for queue-based generation)
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/rankforge/job-created
VITE_N8N_BASE_URL=https://your-n8n-instance.com
VITE_N8N_API_KEY=your-n8n-api-key

# Supabase Edge Functions (set in Supabase dashboard secrets)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# N8N_WEBHOOK_SECRET=your-webhook-secret
# GEMINI_API_KEY=your-gemini-key-for-edge-functions
